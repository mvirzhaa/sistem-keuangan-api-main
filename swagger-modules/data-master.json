    "/api/data-master/unit-kerja": {
      "get": {
        "summary": "Mendapatkan semua unit kerja (flat list)",
        "description": "Endpoint untuk mengambil semua unit kerja dalam bentuk daftar datar dengan informasi parent dan children",
        "tags": [
          "Data Master - Unit Kerja"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Data unit kerja berhasil diambil"
          },
          "401": {
            "description": "Unauthorized - Token required"
          },
          "500": {
            "description": "Server Error"
          }
        }
      },
      "post": {
        "summary": "Membuat unit kerja baru (Super Admin Only)",
        "description": "Endpoint untuk membuat unit kerja baru. Hanya bisa dilakukan oleh super admin.",
        "tags": [
          "Data Master - Unit Kerja"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "universitas": {
                  "summary": "Membuat Universitas",
                  "value": {
                    "kode": "UIKA",
                    "nama": "Universitas Ibn Khaldun Bogor",
                    "singkatan": "UIKA",
                    "level": "UNIVERSITAS"
                  }
                },
                "fakultas": {
                  "summary": "Membuat Fakultas",
                  "value": {
                    "kode": "FEB",
                    "nama": "Fakultas Ekonomi dan Bisnis",
                    "singkatan": "FEB",
                    "level": "FAKULTAS",
                    "parentId": 1
                  }
                },
                "program-studi": {
                  "summary": "Membuat Program Studi",
                  "value": {
                    "kode": "AKT",
                    "nama": "Akuntansi",
                    "singkatan": "AKT",
                    "level": "PROGRAM_STUDI",
                    "parentId": 4
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Unit kerja berhasil dibuat"
          },
          "400": {
            "description": "Validasi gagal"
          },
          "401": {
            "description": "Unauthorized - Token required"
          },
          "403": {
            "description": "Forbidden - Super Admin only"
          },
          "409": {
            "description": "Conflict - Kode sudah ada atau hierarki tidak valid"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/api/data-master/unit-kerja/level": {
      "get": {
        "summary": "Mendapatkan unit kerja berdasarkan level",
        "description": "Endpoint untuk mengambil unit kerja berdasarkan level tertentu (UNIVERSITAS, FAKULTAS, PROGRAM_STUDI)",
        "tags": [
          "Data Master - Unit Kerja"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "level",
            "required": true,
            "description": "Level unit kerja",
            "example": "FAKULTAS",
            "enum": [
              "UNIVERSITAS",
              "FAKULTAS",
              "PROGRAM_STUDI"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Data unit kerja berhasil diambil"
          },
          "400": {
            "description": "Level tidak valid"
          },
          "401": {
            "description": "Unauthorized - Token required"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
